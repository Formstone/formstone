{
  "name": "formstone",
  "id": "formstone",
  "codename": "formstone",
  "realname": "Formstone",
  "version": "2.3.0",
  "description": "Library of modular front end components.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Formstone/Formstone.git"
  },
  "scripts": {
    "gulp": "NODE_ENV='development' gulp",
    "gulp-build": "NODE_ENV='production' gulp",
    "prepublishOnly": "npm run gulp-build",
    "test": "npm run test:node && npm run test:browser",
    "test:node": "node --test \"test/node/*.test.js\"",
    "test:browser": "playwright test"
  },
  "homepage": "https://formstone.dev/",
  "homepage_short": "formstone.dev",
  "demo": "https://formstone.dev/demo/",
  "license": "GPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "sass": "./src/scss/index.scss",
      "import": "./src/js/index.js",
      "require": "./dist/formstone.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./*": "./src/js/*.js",
    "./jquery": "./src/jquery/index.js",
    "./jquery/*": "./src/jquery/*.js",
    "./*.css": "./src/css/*.css",
    "./*.less": "./src/less/*.less",
    "./*.scss": "./src/scss/*.scss"
  },
  "browser": "./dist/formstone.js",
  "engines": {
    "node": ">=20.19"
  },
  "main": "./src/js/index.js",
  "author": {
    "name": "Ben Plum",
    "email": "mr@benplum.com",
    "url": "https://www.benplum.com"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "browserslist": "^4.29.3",
    "gulp": "^5.0.1",
    "gulp-beautify": "^3.0.0",
    "gulp-header": "^2.0.12",
    "gulp-less": "^5.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-strip-css-comments": "^3.0.0",
    "jquery": "^3.7.1",
    "lightningcss": "^1.33.0",
    "sass": "^1.105.1",
    "webpack": "^5.111.1"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./dist/*",
    "./src/jquery/*.js",
    "*.css",
    "*.less",
    "*.scss"
  ]
}
